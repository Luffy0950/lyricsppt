# Copy this file to .env.local and fill in what you want to use.
# Every service below is free. With no keys at all the app still works
# (offline lyric analysis + free Openverse photos).

# ---------- Lyric analysis (pick one; Gemini is tried first) ----------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# If Google retires this model, the app switches to the newest available "flash" model
# automatically and prints the name to use here.
GEMINI_MODEL=

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# auto | gemini | groq | offline
LLM_PROVIDER=auto

# ---------- Backgrounds ----------
# Free Creative Commons photos from Openverse, no key needed. Set to false to turn off.
OPENVERSE_ENABLED=true

# Pollinations AI images work with no key, but add a logo and allow one image every 45 s.
# A token from https://enter.pollinations.ai removes both limits.
POLLINATIONS_ENABLED=true
POLLINATIONS_TOKEN=
POLLINATIONS_MODEL=flux

# Licensed stock photos: https://www.pexels.com/api/ (used instead of Openverse when set)
PEXELS_API_KEY=

# ---------- Database ----------
# mysql = XAMPP / Laragon / any MySQL, MariaDB or TiDB server
# file  = JSON files in DATA_DIR (no setup)
# The database and tables are created automatically on first start.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lyrics2ppt
# true for hosted databases that require an encrypted connection (TiDB Cloud does)
DB_SSL=false

# ---------- Server ----------
# Where background images (and JSON projects, if DB_DRIVER=file) are stored.
# DATA_DIR=./data

# Set this before putting the app on the internet (HTTP Basic auth, any username).
APP_PASSWORD=
